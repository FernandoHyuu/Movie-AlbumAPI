{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=streamingpanel;Username=app;Password=app"
  },
  "Database": {
    "ConnectTimeoutSeconds": 60
  },
  "Jwt": {
    "SigningKey": "dev-only-signing-key-change-me-at-least-32-bytes-long!!",
    "Issuer": "StreamingPanel",
    "Audience": "StreamingPanel",
    "RefreshGraceSeconds": 8
  },
  "Cors": {
    "FrontendOrigin": "http://localhost:4200"
  }
}
