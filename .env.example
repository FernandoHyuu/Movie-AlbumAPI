# Streaming Panel compose environment variables (R21).
# Copy this file to `.env` and fill in secrets before running `docker compose up`.

# --- PostgreSQL ---
POSTGRES_DB=streamingpanel
POSTGRES_USER=app
# Required: database password for the app user.
DB_PASSWORD=change-me-strong-db-password

# --- API ---
# Required: HMAC signing key for JWT access tokens (use a long random value, >= 32 bytes).
JWT_SIGNING_KEY=change-me-to-a-long-random-signing-key-at-least-32-bytes
# Exact single allowed browser origin for CORS (scheme+host+port).
FRONTEND_ORIGIN=http://localhost:4200
# Bounded startup DB connect/retry timeout, in seconds (R21.4, R21.5).
DB_CONNECT_TIMEOUT_SECONDS=60
# ASP.NET Core environment (Production | Development).
ASPNETCORE_ENVIRONMENT=Production
# Host port that maps to the API container's port 8080 (R21.6).
API_HOST_PORT=8080

# --- pgAdmin ---
PGADMIN_EMAIL=admin@streamingpanel.local
# Required: pgAdmin login password.
PGADMIN_PASSWORD=change-me-pgadmin-password
# Host port that maps to the pgAdmin container's port 80 (R21.6).
PGADMIN_HOST_PORT=5050
