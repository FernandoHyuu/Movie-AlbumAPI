                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Movie",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Blade Runner (Final Cut)\",\n  \"studio\": \"Warner Bros.\",\n  \"releaseYear\": 1982,\n  \"mainActors\": [ \"Harrison Ford\" ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/movies/{{movieId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "movies", "{{movieId}}" ]
            },
            "description": "Updates a movie (200); unknown id returns 404."
          }
        },
        {
          "name": "Delete Movie",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/movies/{{movieId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "movies", "{{movieId}}" ]
            },
            "description": "Deletes a movie (204); unknown id returns 404."
          }
        },
        {
          "name": "Get Movie Cover",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/movies/{{movieId}}/cover",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "movies", "{{movieId}}", "cover" ]
            },
            "description": "Streams the stored cover bytes with their Content-Type; missing cover returns 404."
          }
        },
        {
          "name": "Upload Movie Cover",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [], "description": "Image file (image/jpeg|png|webp, <=5 MB)." }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/movies/{{movieId}}/cover",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "movies", "{{movieId}}", "cover" ]
            },
            "description": "Stores (replaces) the cover from a multipart/form-data upload (204); missing record returns 404."
          }
        }
      ]
    },
